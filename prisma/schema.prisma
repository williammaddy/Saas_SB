generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String
  name          String
  phone         String?
  organizations OrganizationMember[]
  auditLogs     AuditLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  businessType        String               @default("RETAIL") // RETAIL, WHOLESALE, SERVICE, SALON, FREELANCER, CONSULTANT, REPAIR, OTHER
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  stateCode           String?              // 2-digit GST state code e.g. "33", "27"
  pincode             String?
  country             String               @default("India")
  currency            String               @default("INR")
  timezone            String               @default("Asia/Kolkata")
  dateFormat          String               @default("DD/MM/YYYY")
  logoUrl             String?
  gstEnabled          Boolean              @default(false)
  gstin               String?
  defaultTaxRate      Decimal              @default(0) @db.Decimal(5, 2)
  invoicePrefix       String               @default("INV-")
  nextInvoiceNumber   Int                  @default(1)
  defaultPaymentTerms String               @default("Due on Receipt")
  onboardingCompleted Boolean              @default(false)
  members             OrganizationMember[]
  customers           Customer[]
  items               Item[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("OWNER") // OWNER, ADMIN, STAFF
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  stateCode      String?
  pincode        String?
  gstin          String?
  notes          String?
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, phone])
}

model Item {
  id              String        @id @default(uuid())
  organizationId  String
  type            String        @default("PRODUCT") // PRODUCT, SERVICE
  name            String
  sku             String?
  category        String?
  description     String?
  sellingPrice    Decimal       @db.Decimal(12, 2)
  purchasePrice   Decimal?      @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  unit            String        @default("pcs")
  durationMinutes Int?
  stock           Decimal?      @db.Decimal(12, 2) // null for service, number for product
  minimumStock    Decimal?      @db.Decimal(12, 2) // threshold for low stock alert
  isActive        Boolean       @default(true)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems    InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, name])
}

model Invoice {
  id                String        @id @default(uuid())
  organizationId    String
  invoiceNumber     String
  customerId        String?       // NULL for Walk-in Customer
  customerName      String        // "Walk-in Customer" or customer name
  customerPhone     String?
  customerEmail     String?
  customerAddress   String?
  customerGstin     String?
  customerStateCode String?
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime?
  status            String        @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, CANCELLED
  isGst             Boolean       @default(false)
  isInterState      Boolean       @default(false)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountType      String        @default("FIXED") // PERCENTAGE, FIXED
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal       @db.Decimal(12, 2)
  cgstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount        Decimal       @default(0) @db.Decimal(12, 2)
  totalTax          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount     Decimal       @db.Decimal(12, 2)
  paymentMethod     String        @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER, CREDIT, OTHER
  notes             String?
  terms             String?
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, status])
}

model InvoiceItem {
  id             String       @id @default(uuid())
  organizationId String
  invoiceId      String
  itemId         String?
  itemType       String       @default("PRODUCT") // PRODUCT, SERVICE
  name           String
  description    String?
  quantity       Decimal      @db.Decimal(12, 2)
  unit           String       @default("pcs")
  unitPrice      Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  taxableAmount  Decimal      @db.Decimal(12, 2)
  cgstRate       Decimal      @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  sgstRate       Decimal      @default(0) @db.Decimal(5, 2)
  sgstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  igstRate       Decimal      @default(0) @db.Decimal(5, 2)
  igstAmount     Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

model Payment {
  id              String       @id @default(uuid())
  organizationId  String
  invoiceId       String
  amount          Decimal      @db.Decimal(12, 2)
  paymentDate     DateTime     @default(now())
  paymentMethod   String       @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER, OTHER
  referenceNumber String?
  notes           String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  date           DateTime     @default(now())
  category       String       // RENT, SALARY, ELECTRICITY, INTERNET, TRANSPORT, MARKETING, MAINTENANCE, OTHER
  amount         Decimal      @db.Decimal(12, 2)
  paymentMethod  String       @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER, OTHER
  description    String?
  attachmentUrl  String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, category])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}
